<script>
(()=>{
 const cases=[
  {kind:'BASE SELECTION',title:'対面操作を回して削り切る。',team:['サザンドラ','メガグソクムシャ','ウォッシュロトム'],desc:'サザンの高速とんぼ、グソクの高火力先制技と低速とんぼ、ミトムの鬼火＋ボルチェンを使い分ける。削った相手をスカーフと先制技で締める。',warn:'相手の炎打点・ステロ展開・フェアリーの数を見て、基本選出へのこだわり過ぎを避ける。'},
  {kind:'FAIRY ANSWER',title:'フェアリーを受ける枠を増やす。',team:['メガグソクムシャ','ガラルヤドキング','ウォッシュロトム'],desc:'アシレーヌやミミッキュが厚い相手は、サザンを外してガラキンを採用する発想。グソクの鋼技とガラキンの毒技でフェアリーへの回答を2枚用意する。',warn:'相手にメガガブリアスZなどの高速ドラゴンが同居するなら、スカーフサザンを残すパターンも検討。'},
  {kind:'TWO-THREAT MANAGEMENT',title:'ドラゴンの速度とフェアリーを両立。',team:['サザンドラ','メガグソクムシャ','ガラルヤドキング'],desc:'サザンをスカーフの高速処理担当として残し、グソクとガラキンでアシレーヌなどに対応する。メガガブZに対しては無理な受け出しより、削って上から処理するルートを確保。',warn:'相手の初手ステロやグソクへの炎技を確認し、受け出し回数を過信しない。'},
  {kind:'ELECTRIC IMMUNITY',title:'電気の一貫をガブリアスで切る。',team:['ガブリアス','メガグソクムシャ','サザンドラ'],desc:'ミトムを外してガブリアスを投入。電気無効と炎半減を活かし、ステロ・岩石封じでグソクの先制技圏内を作る。',warn:'サザン＋ガブのドラゴン2枚なので、フェアリーが複数いる相手には選出を再検討。ヒートロトムの浮遊には地震が無効。'},
  {kind:'SECOND MEGA PLAN',title:'裏メガのバシャーモを通す。',team:['メガバシャーモ','ウォッシュロトム','ガブリアス'],desc:'リザードンやヒートロトムなど、グソクを選びにくい炎・飛行中心の相手を意識。ガブの岩石封じ・ステロ、ミトムの対面操作からバシャーモへつなぐ。',warn:'いわなだれ採用を想定した一例。アシレーヌが同居する場合はガラキンの選出優先度が上がる。'},
  {kind:'BULKY MATCHUP',title:'再生力と抜群打点で崩す。',team:['ガラルヤドキング','ウォッシュロトム','メガバシャーモ'],desc:'ドヒドイデにはガラキンのサイコキネシス、ミトムの電気打点で圧力をかける。鋼・受け回しの崩しにはバシャーモも候補。',warn:'サイコキネシスはドヒドイデのじこさいせいを封じない。相手の耐久や残り2体を考慮して選ぶ。'}
 ];
 const tabs=[...document.querySelectorAll('[data-case]')];
 function setCase(i){const x=cases[i];tabs.forEach((t,k)=>{t.setAttribute('aria-selected',String(i===k));t.tabIndex=i===k?0:-1;});const panel=document.getElementById('case-result');panel.setAttribute('aria-labelledby','case-tab-'+i);document.getElementById('case-kind').textContent=x.kind;document.getElementById('case-title').textContent=x.title;document.getElementById('case-desc').textContent=x.desc;document.getElementById('case-warn').textContent='注意：'+x.warn;const row=document.getElementById('case-team');row.replaceChildren();x.team.forEach(name=>{let b=document.createElement('b');b.textContent=name;if(name.startsWith('メガ'))b.className='mega';row.append(b);});}
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>setCase(i));tab.addEventListener('keydown',e=>{let n;if(e.key==='ArrowDown'||e.key==='ArrowRight')n=(i+1)%tabs.length;if(e.key==='ArrowUp'||e.key==='ArrowLeft')n=(i+tabs.length-1)%tabs.length;if(n!==undefined){e.preventDefault();setCase(n);tabs[n].focus();}});});
 const dialog=document.getElementById('imageDialog');const out=document.getElementById('dialogImg');const images={moves:{url:document.querySelector('[data-image="moves"] img').src,title:'前期構築 / 技・持ち物'},stats:{url:document.querySelector('[data-image="stats"] img').src,title:'前期構築 / 能力値・能力ポイント'}};
 document.querySelectorAll('[data-image]').forEach(btn=>btn.addEventListener('click',()=>{const v=images[btn.dataset.image];out.src=v.url;out.alt=v.title;document.getElementById('dialogTitle').textContent=v.title;if(typeof dialog.showModal==='function')dialog.showModal();else window.open(v.url,'_blank');}));document.getElementById('closeDialog').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});
})();
</script>
